<string name="keyword_rules_title">कीवर्ड नियम</string><string name="keyword_rules_help">नियम केवल ऑटो-क्लीन चालू होने पर चलते हैं। सुरक्षित ऐप हमेशा प्राथमिकता में रहते हैं।</string><string name="no_rules">अभी कोई नियम नहीं है। सूचना का शीर्षक या पाठ जाँचने के लिए नियम जोड़ें।</string><string name="auto_dismiss">अपने-आप हटाएँ</string><string name="mark_for_review">समीक्षा के लिए चिह्नित करें</string><string name="add_rule">कीवर्ड नियम जोड़ें</string><string name="edit_rule">कीवर्ड नियम संपादित करें</string><string name="rule_pattern_hint">टेक्स्ट या रेगुलर एक्सप्रेशन</string><string name="case_sensitive">अक्षरों के बड़े-छोटे रूप का ध्यान रखें</string><string name="save">सेव करें</string><string name="cancel">रद्द करें</string><string name="empty_pattern_error">टेक्स्ट या पैटर्न दर्ज करें।</string><string name="unsafe_regex_error">रेगुलर एक्सप्रेशन अमान्य या बहुत जटिल है। 100 वर्णों तक का सरल पैटर्न इस्तेमाल करें।</string><string name="match_type">मिलान</string><string name="match_contains">इसमें शामिल है</string><string name="match_exact">बिल्कुल मेल</string><string name="match_starts">इससे शुरू</string><string name="match_regex">रेगुलर एक्सप्रेशन</string><string name="rule_scope">कहाँ लागू करें</string><string name="scope_title">शीर्षक</string><string name="scope_text">पाठ</string><string name="scope_both">शीर्षक या पाठ</string><string name="rule_action">कार्रवाई</string>
<string name="notification_history_title">सूचना इतिहास</string><string name="search_history">ऐप या नियम खोजें</string><string name="all_apps">सभी</string><string name="no_history">इस फ़िल्टर के लिए कोई गतिविधि नहीं है। सूचना की सामग्री सेव नहीं होती।</string><string name="clear_history_title">स्थानीय इतिहास मिटाएँ?</string><string name="clear_history_message">इस डिवाइस में सेव गतिविधि मेटाडेटा हट जाएगा। Android द्वारा हटाई गई सूचनाएँ यहाँ वापस नहीं लाई जा सकतीं।</string><string name="delete">मिटाएँ</string><string name="history_requested">हटाने का अनुरोध</string><string name="history_auto_dismissed">अपने-आप हटाया गया</string><string name="history_review">समीक्षा के लिए चिह्नित</string><string name="history_kept">रखा गया</string><string name="history_recorded">दर्ज किया गया</string><string name="history_failed">अनुरोध विफल</string><string name="history_unknown">नतीजा अज्ञात</string><string name="matched_rule">मेल खाता नियम: %1$s</string>
<string name="settings_privacy_title">सेटिंग और गोपनीयता</string><string name="on_device_processing">डिवाइस पर प्रोसेसिंग</string><string name="privacy_details">नियम जाँचने के लिए सूचना का पाठ केवल मेमोरी में पढ़ा जाता है। इतिहास में ऐप, समय, मेल खाता नियम और कार्रवाई सेव होते हैं, सूचना की सामग्री नहीं। सूचना डेटा किसी सर्वर को नहीं भेजा जाता।</string><string name="retention_days">इतिहास रखने की अवधि: %1$d दिन</string><string name="retention_details">यह सेटिंग बदलने पर और ऐप शुरू होने पर पुराने गतिविधि मेटाडेटा हटाए जाते हैं।</string><string name="android_limits">Android की सीमाएँ</string><string name="android_limits_details">Android सेटिंग में सूचना एक्सेस चालू करना ज़रूरी है। कौन-सी सूचनाएँ हटाई जा सकती हैं, यह Android तय करता है; अनुरोध से हर प्रकार की सूचना हटने की गारंटी नहीं होती। शांत समय उपलब्ध नहीं है, क्योंकि इससे पूरे डिवाइस की Do Not Disturb नीति बदल जाएगी।</string>
