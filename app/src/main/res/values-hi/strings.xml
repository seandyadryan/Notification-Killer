<string name="notification_access_service_name">Notification Killer — सूचना फ़िल्टर</string><string name="notification_access_service_description">चुने गए फ़िल्टर लागू करने के लिए सूचनाओं का शीर्षक और पाठ इसी डिवाइस पर पढ़ता है। सूचना की सामग्री सेव या साझा नहीं की जाती।</string>
<string name="access_connected">सूचना एक्सेस: कनेक्ट है</string><string name="access_not_connected">सूचना एक्सेस: कनेक्ट नहीं है</string><string name="access_explanation">यह एक्सेस नियम जाँचने के लिए सूचना का शीर्षक और पाठ अस्थायी रूप से पढ़ने देता है। सामग्री सेव या साझा नहीं होती; इतिहास में केवल गतिविधि का मेटाडेटा रखा जाता है।</string><string name="open_access_settings">सूचना एक्सेस सेटिंग खोलें</string><string name="auto_clean">ऑटो-क्लीन चालू करें</string><string name="detected_today">आज मिली सूचनाएँ</string><string name="dismiss_requests">हटाने के अनुरोध</string><string name="filtered_apps">फ़िल्टर किए गए ऐप</string><string name="active_rules">सक्रिय नियम</string><string name="recent_activity">हाल की गतिविधि</string>
