<string name="notification_access_service_name">Notification Killer — filtre de notifications</string><string name="notification_access_service_description">Lit localement le titre et le texte des notifications pour appliquer les filtres choisis. Leur contenu n’est ni enregistré ni envoyé.</string>
<string name="access_connected">Accès aux notifications : connecté</string><string name="access_not_connected">Accès aux notifications : non connecté</string><string name="access_explanation">Cet accès permet de lire temporairement les titres et textes pour évaluer vos règles. Le contenu n’est ni enregistré ni envoyé ; l’historique ne conserve que des métadonnées.</string><string name="open_access_settings">Ouvrir les paramètres d’accès</string><string name="auto_clean">Activer le nettoyage automatique</string><string name="detected_today">Détectées aujourd’hui</string><string name="dismiss_requests">Demandes de suppression</string><string name="filtered_apps">Applications filtrées</string><string name="active_rules">Règles actives</string><string name="recent_activity">Activité récente</string>
